 "vo": [
  {
   "line": "vo01_problem",
   "scene": "k1",
   "t": 1.0,
   "dur": 3.9,
   "speaker": "advait",
   "text": "Every day, lenders send the same reminder to every borrower."
  },
  {
   "line": "vo02_pain",
   "scene": "k2",
   "t": 7.6,
   "dur": 3.99,
   "speaker": "advait",
   "text": "It's expensive. It's annoying. And it gets ignored."
  },
  {
   "line": "vo03_meet",
   "scene": "k3",
   "t": 15.05,
   "dur": 1.15,
   "speaker": "advait",
   "text": "Meet Kairos."
  },
  {
   "line": "vo04_decides",
   "scene": "k4",
   "t": 18.9,
   "dur": 4.15,
   "speaker": "advait",
   "text": "It decides, for each person, each day, whether to reach out, or wait."
  },
  {
   "line": "vo05_channels",
   "scene": "k6",
   "t": 26.35,
   "dur": 2.56,
   "speaker": "advait",
   "text": "SMS. WhatsApp. Voice. Or a human."
  },
  {
   "line": "agent01_hi",
   "scene": "k6b",
   "t": 30.25,
   "dur": 4.95,
   "speaker": "ritu",
   "text": "नमस्ते! आपकी EMI की तारीख कल है। क्या मैं आपको पेमेंट लिंक भेज दूँ?"
  },
  {
   "line": "agent02_en",
   "scene": "k6b",
   "t": 35.6,
   "dur": 3.41,
   "speaker": "ritu",
   "text": "Sure, sending your payment link on WhatsApp right now."
  },
  {
   "line": "vo06_aladdin",
   "scene": "k7",
   "t": 39.475,
   "dur": 3.26,
   "speaker": "advait",
   "text": "Every decision is checked by Aladdin. Twice."
  },
  {
   "line": "vo07_stop",
   "scene": "k8",
   "t": 43.225,
   "dur": 2.52,
   "speaker": "advait",
   "text": "Say stop, and it stops. Everywhere."
  },
  {
   "line": "vo08_fake",
   "scene": "k9",
   "t": 46.975,
   "dur": 2.05,
   "speaker": "advait",
   "text": "Fake payment proof? Caught."
  },
  {
   "line": "vo09_learns",
   "scene": "k11",
   "t": 54.475,
   "dur": 2.93,
   "speaker": "advait",
   "text": "And it learns, live, from every reply."
  },
  {
   "line": "vo10_proof",
   "scene": "k13",
   "t": 69.625,
   "dur": 4.78,
   "speaker": "advait",
   "text": "Twice the money recovered for every rupee spent. Zero rule breaches."
  },
  {
   "line": "vo11_end",
   "scene": "k16",
   "t": 81.615,
   "dur": 4.66,
   "speaker": "advait",
   "text": "Kairos. The right message, at the right time. Or none at all."
  }
 ],
