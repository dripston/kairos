[
 {
  "t0": 8.5,
  "t1": 12.167,
  "who": "",
  "lines": [
   "Every month,",
   "millions of Indians repay a loan,"
  ]
 },
 {
  "t0": 12.187,
  "t1": 17.407,
  "who": "",
  "lines": [
   "and get the same reminder,",
   "at the same time, as everyone else."
  ]
 },
 {
  "t0": 17.667,
  "t1": 20.085,
  "who": "",
  "lines": [
   "In one simulated campaign,"
  ]
 },
 {
  "t0": 20.105,
  "t1": 26.085,
  "who": "",
  "lines": [
   "that fixed schedule sent 1,262 messages,",
   "and paid for every one."
  ]
 },
 {
  "t0": 26.105,
  "t1": 28.792,
  "who": "",
  "lines": [
   "Only 23 replies came back."
  ]
 },
 {
  "t0": 31.172,
  "t1": 32.842,
  "who": "",
  "lines": [
   "Kairos works differently."
  ]
 },
 {
  "t0": 32.862,
  "t1": 36.9,
  "who": "",
  "lines": [
   "Every morning, it looks at each borrower:",
   "how late they are,"
  ]
 },
 {
  "t0": 36.92,
  "t1": 41.294,
  "who": "",
  "lines": [
   "how they replied before,",
   "and when they usually read messages."
  ]
 },
 {
  "t0": 41.534,
  "t1": 44.61,
  "who": "",
  "lines": [
   "Then it decides: reach out today, or wait."
  ]
 },
 {
  "t0": 44.63,
  "t1": 48.935,
  "who": "",
  "lines": [
   "And if it reaches out,",
   "which channel, and at what hour."
  ]
 },
 {
  "t0": 49.186,
  "t1": 54.019,
  "who": "",
  "lines": [
   "All within a fixed daily budget,",
   "with a report every evening on what worked."
  ]
 },
 {
  "t0": 56.738,
  "t1": 62.536,
  "who": "",
  "lines": [
   "Before any message goes out, it has",
   "to get past Aladdin, our safety supervisor."
  ]
 },
 {
  "t0": 62.566,
  "t1": 65.974,
  "who": "",
  "lines": [
   "Has this person agreed to this channel?",
   "Asked us to stop?"
  ]
 },
 {
  "t0": 65.994,
  "t1": 69.101,
  "who": "",
  "lines": [
   "Is it between 8 in the morning",
   "and 7 in the evening?"
  ]
 },
 {
  "t0": 69.121,
  "t1": 71.507,
  "who": "",
  "lines": [
   "Have we contacted them enough this week?"
  ]
 },
 {
  "t0": 71.527,
  "t1": 74.483,
  "who": "",
  "lines": [
   "Is there budget left?",
   "Is the account on hold?"
  ]
 },
 {
  "t0": 74.514,
  "t1": 80.028,
  "who": "",
  "lines": [
   "Aladdin checks when the message is planned,",
   "and again right before it is sent."
  ]
 },
 {
  "t0": 80.048,
  "t1": 83.491,
  "who": "",
  "lines": [
   "If any answer is no,",
   "the message does not go."
  ]
 },
 {
  "t0": 84.451,
  "t1": 89.478,
  "who": "",
  "lines": [
   "This is Vikram.",
   "His EMI of ₹7,409 is 10 days late."
  ]
 },
 {
  "t0": 89.498,
  "t1": 95.2,
  "who": "",
  "lines": [
   "Kairos sends one SMS at 9:30",
   "in the morning. No reply."
  ]
 },
 {
  "t0": 95.58,
  "t1": 97.489,
  "who": "",
  "lines": [
   "So the next day, it waits."
  ]
 },
 {
  "t0": 97.509,
  "t1": 100.06,
  "who": "",
  "lines": [
   "On day 3, it tries WhatsApp,",
   "and Vikram replies: he'll pay by the 29th."
  ]
 },
 {
  "t0": 100.08,
  "t1": 102.03,
  "who": "Vikram",
  "lines": [
   "I'll pay by the 29th."
  ]
 },
 {
  "t0": 103.48,
  "t1": 106.577,
  "who": "",
  "lines": [
   "Kairos sees a promise to pay and goes quiet."
  ]
 },
 {
  "t0": 106.597,
  "t1": 111.664,
  "who": "",
  "lines": [
   "On day 7, the bank confirms the payment.",
   "Reaching him cost 65 paise."
  ]
 },
 {
  "t0": 112.073,
  "t1": 114.502,
  "who": "",
  "lines": [
   "Kairos learns from every reply."
  ]
 },
 {
  "t0": 114.522,
  "t1": 120.98,
  "who": "",
  "lines": [
   "Midway through, we made WhatsApp work worse",
   "for one group and told Kairos nothing."
  ]
 },
 {
  "t0": 121.0,
  "t1": 126.069,
  "who": "",
  "lines": [
   "Its estimate fell,",
   "and it moved that group to SMS on its own."
  ]
 },
 {
  "t0": 132.659,
  "t1": 134.491,
  "who": "Sunita",
  "lines": [
   "When is my EMI due?"
  ]
 },
 {
  "t0": 134.751,
  "t1": 136.007,
  "who": "Kairos",
  "lines": [
   "To protect your account,"
  ]
 },
 {
  "t0": 136.027,
  "t1": 139.574,
  "who": "Kairos",
  "lines": [
   "I have sent a 6-digit code",
   "to your registered WhatsApp number."
  ]
 },
 {
  "t0": 139.774,
  "t1": 141.681,
  "who": "Kairos",
  "lines": [
   "Thank you, you are verified."
  ]
 },
 {
  "t0": 142.041,
  "t1": 147.77,
  "who": "",
  "lines": [
   "Notice: nothing about her loan is shared",
   "until she proves who she is."
  ]
 },
 {
  "t0": 147.96,
  "t1": 150.811,
  "who": "Sunita",
  "lines": [
   "I already paid,",
   "here is the screenshot."
  ]
 },
 {
  "t0": 150.991,
  "t1": 154.187,
  "who": "Kairos",
  "lines": [
   "For your security,",
   "I can't help with this request in chat."
  ]
 },
 {
  "t0": 154.207,
  "t1": 156.786,
  "who": "Kairos",
  "lines": [
   "A specialist",
   "from our team will review it."
  ]
 },
 {
  "t0": 157.096,
  "t1": 158.854,
  "who": "",
  "lines": [
   "That screenshot was edited."
  ]
 },
 {
  "t0": 158.874,
  "t1": 162.345,
  "who": "",
  "lines": [
   "Kairos checks every proof",
   "against the bank's records,"
  ]
 },
 {
  "t0": 162.365,
  "t1": 166.434,
  "who": "",
  "lines": [
   "so a fake one goes to a person,",
   "never marks the loan paid."
  ]
 },
 {
  "t0": 166.844,
  "t1": 170.309,
  "who": "",
  "lines": [
   "When another borrower",
   "says she has lost her job,"
  ]
 },
 {
  "t0": 170.329,
  "t1": 174.5,
  "who": "",
  "lines": [
   "Kairos pauses her reminders",
   "and hands her to a person."
  ]
 },
 {
  "t0": 174.671,
  "t1": 175.577,
  "who": "Sunita",
  "lines": [
   "Stop."
  ]
 },
 {
  "t0": 176.557,
  "t1": 180.4,
  "who": "Kairos",
  "lines": [
   "You will not receive further",
   "automated reminders from us on any channel."
  ]
 },
 {
  "t0": 180.8,
  "t1": 184.35,
  "who": "",
  "lines": [
   "And when someone says stop,",
   "everything stops."
  ]
 },
 {
  "t0": 184.37,
  "t1": 188.111,
  "who": "",
  "lines": [
   "SMS, WhatsApp, email and calls, all at once."
  ]
 },
 {
  "t0": 188.45,
  "t1": 193.849,
  "who": "",
  "lines": [
   "The team stays in charge: approve a call,",
   "pause a borrower, take over a chat."
  ]
 },
 {
  "t0": 193.869,
  "t1": 195.819,
  "who": "",
  "lines": [
   "And Aladdin checks them too."
  ]
 },
 {
  "t0": 195.839,
  "t1": 199.959,
  "who": "",
  "lines": [
   "Not even a supervisor can send a message",
   "at 8 at night."
  ]
 },
 {
  "t0": 200.3,
  "t1": 201.789,
  "who": "",
  "lines": [
   "In our simulated tests,"
  ]
 },
 {
  "t0": 201.809,
  "t1": 206.119,
  "who": "",
  "lines": [
   "Kairos recovered more",
   "for every rupee spent than a fixed schedule,"
  ]
 },
 {
  "t0": 206.139,
  "t1": 208.423,
  "who": "",
  "lines": [
   "without breaking a single rule."
  ]
 }
]